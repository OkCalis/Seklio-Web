---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../Icon.astro';
import { SITE, type Locale } from '../../config';
import { t } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  operatingSystem: 'iOS',
  applicationCategory: 'CommunicationApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: SITE.url + `/${locale}/`,
  description: d.meta.landingDescription,
});
---

<BaseLayout
  locale={locale}
  slug=""
  title={d.meta.landingTitle}
  description={d.meta.landingDescription}
>
  <section class="hero">
    <div class="container">
      <div>
        <span class="hero-badge">
          <Icon name="offline" />
          {d.hero.badge}
        </span>
        <h1>{d.hero.title}</h1>
        <p class="hero-sub">{d.hero.subtitle}</p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href={SITE.testflightUrl} rel="noopener" data-cta="ios">
            {d.hero.ctaIos}
          </a>
          <a class="btn btn-secondary" href={SITE.alphaGroupUrl} data-cta="alpha">
            {d.hero.ctaAlpha}
          </a>
          <a class="btn btn-secondary" href={SITE.androidApkUrl} data-apk-button>
            {d.hero.ctaAndroid}
          </a>
        </div>
        <p class="hero-note">{d.hero.note}</p>
      </div>
      <div class="hero-visual">
        <img class="hero-logo" src="/logo-512.png" alt="Seklio" width="512" height="512" />
      </div>
    </div>
  </section>

  <script is:inline type="application/ld+json" set:html={structuredData} />

  <script is:inline define:vars={{ repo: SITE.androidReleaseRepo, fallback: SITE.androidApkUrl }}>
    // Resolve the newest .apk asset at click time so the button keeps working
    // while release filenames change build to build. Any failure (rate limit,
    // offline, no asset) falls back to the releases page.
    let apkPromise;
    const resolveApkUrl = () => {
      apkPromise ??= fetch(`https://api.github.com/repos/${repo}/releases?per_page=10`, {
        headers: { Accept: 'application/vnd.github+json' },
      })
        .then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
        .then((releases) => {
          for (const release of releases) {
            const apk = (release.assets || []).find((a) => a.name.endsWith('.apk'));
            if (apk) return apk.browser_download_url;
          }
          throw new Error('no .apk asset found');
        })
        .catch((err) => {
          apkPromise = undefined; // allow a retry on the next click
          throw err;
        });
      return apkPromise;
    };

    // Delegate from document: this script runs mid-parse, before the second
    // button exists in the DOM, so per-element listeners would miss it.
    document.addEventListener('click', (event) => {
      const el = event.target instanceof Element && event.target.closest('[data-apk-button]');
      if (!el) return;
      event.preventDefault();
      el.setAttribute('aria-busy', 'true');
      resolveApkUrl()
        .then((url) => {
          window.location.href = url;
        })
        .catch(() => {
          window.location.href = fallback;
        })
        .finally(() => {
          el.removeAttribute('aria-busy');
        });
    });
  </script>

  <section class="section" id="how">
    <div class="container">
      <div class="section-head">
        <h2>{d.how.title}</h2>
        <p>{d.how.subtitle}</p>
      </div>
      <div class="steps">
        {
          d.how.steps.map((s, i) => (
            <div class="step">
              <div class="step-num">{i + 1}</div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt" id="features">
    <div class="container">
      <div class="section-head">
        <h2>{d.features.title}</h2>
        <p>{d.features.subtitle}</p>
      </div>
      <div class="feature-grid">
        {
          d.features.items.map((f) => (
            <div class="feature">
              <div class="feature-icon">
                <Icon name={f.icon} />
              </div>
              <h3>
                {f.title}
                {'soon' in f && f.soon && <span class="soon-badge">{d.comingSoon}</span>}
              </h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="privacy-card">
        <div>
          <h2>{d.privacy.title}</h2>
          <p>{d.privacy.body}</p>
          <a href={`/${locale}/privacy/`}>{d.privacy.link} →</a>
        </div>
        <ul class="privacy-points">
          {
            d.privacy.points.map((p) => (
              <li>
                <Icon name="check" />
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="download">
    <div class="container">
      <div class="section-head">
        <h2>{d.download.title}</h2>
        <p>{d.download.subtitle}</p>
      </div>
      <div class="download-grid">
        <div class="download-card" data-card="ios">
          <div class="platform-icon"><Icon name="apple" /></div>
          <h3>{d.download.iosTitle}</h3>
          <p>{d.download.iosBody}</p>
          <a class="btn btn-primary" href={SITE.testflightUrl} rel="noopener">
            {d.download.iosCta}
          </a>
        </div>
        <div class="download-card" data-card="android">
          <div class="platform-icon"><Icon name="android" /></div>
          <h3>{d.download.androidTitle}</h3>
          <p>{d.download.androidBody}</p>
          <div class="btn-stack">
            <a class="btn btn-primary" href={SITE.alphaGroupUrl}>{d.download.alphaCta}</a>
            <a class="btn btn-secondary" href={SITE.androidApkUrl} data-apk-button>
              {d.download.androidCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Platform-aware promotion (progressive enhancement): Android visitors
    // get the Android options first and styled primary; iOS visitors already
    // see the iOS-first default; everyone else keeps the neutral layout.
    // This script sits after the download section so both surfaces exist.
    (() => {
      const ua = navigator.userAgent;
      // Macs count as iOS: Apple-silicon Macs (and iPadOS 13+, which
      // masquerades as a desktop Mac — "Macintosh" UA) can install the iOS app.
      const isIOS = /iPad|iPhone|iPod|Macintosh/.test(ua) || /^Mac/.test(navigator.platform);
      const isAndroid = !isIOS && /Android/i.test(ua);
      document.documentElement.dataset.platform = isIOS ? 'ios' : isAndroid ? 'android' : 'other';
      if (!isAndroid) return;

      const ctas = document.querySelector('.hero-ctas');
      if (ctas) {
        const ios = ctas.querySelector('[data-cta="ios"]');
        const alpha = ctas.querySelector('[data-cta="alpha"]');
        alpha?.classList.replace('btn-secondary', 'btn-primary');
        if (ios) {
          ios.classList.replace('btn-primary', 'btn-secondary');
          ctas.append(ios); // Android buttons lead, iOS moves last
        }
      }

      const grid = document.querySelector('.download-grid');
      const iosCard = grid?.querySelector('[data-card="ios"]');
      if (grid && iosCard) grid.append(iosCard); // Android card first
    })();
  </script>
</BaseLayout>
